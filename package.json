{
	"name": "packablock-registry",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"start": "bun run index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"format:write": "biome format --write .",
		"release": "bun run scripts/release.ts",
		"check-all": "bun run typecheck && bun run lint && bun run format:check && bun run test"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "latest",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"fastify": "^5.10.0",
		"jose": "^6.2.4",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"fast-uri": "^3.1.5",
		"find-my-way": "^9.6.1"
	},
	"version": "1.2.0"
}
